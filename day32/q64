//Q64: Find the digit that occurs the most times in an integer number.

#include <stdio.h>

int main()
{
    long long n;
    int count[10] = {0};
    int digit, max = 0, result = 0, i;

    scanf("%lld", &n);

    while(n > 0)
    {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }

    for(i = 0; i <= 9; i++)
    {
        if(count[i] > max)
        {
            max = count[i];
            result = i;
        }
    }

    printf("%d", result);

    return 0;
}
