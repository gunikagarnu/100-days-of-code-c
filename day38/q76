//Q76: Check if a matrix is symmetric.

#include <stdio.h>

int main()
{
    int a[100][100];
    int n, m, i, j, symmetric = 1;

    scanf("%d %d", &n, &m);

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < m; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    if(n != m)
    {
        symmetric = 0;
    }
    else
    {
        for(i = 0; i < n; i++)
        {
            for(j = 0; j < n; j++)
            {
                if(a[i][j] != a[j][i])
                {
                    symmetric = 0;
                    break;
                }
            }
        }
    }

    if(symmetric == 1)
    {
        printf("True");
    }
    else
    {
        printf("False");
    }

    return 0;
}
