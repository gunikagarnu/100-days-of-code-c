//Q96: Reverse each word in a sentence without changing the word order.

#include <stdio.h>

int main()
{
    char str[200], temp;
    int i = 0, start = 0, end, j;

    fgets(str, sizeof(str), stdin);

    while(1)
    {
        if(str[i] == ' ' || str[i] == '\n' || str[i] == '\0')
        {
            end = i - 1;

            for(j = start; j < end; j++, end--)
            {
                temp = str[j];
                str[j] = str[end];
                str[end] = temp;
            }

            start = i + 1;
        }

        if(str[i] == '\n')
        {
            str[i] = '\0';
            break;
        }

        if(str[i] == '\0')
        {
            break;
        }

        i++;
    }

    printf("%s", str);

    return 0;
}
