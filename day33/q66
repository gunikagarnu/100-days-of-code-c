Q66: Insert an element in a sorted array at the appropriate position.

#include <stdio.h>

int main()
{
    int a[100], n, i, element, pos;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    scanf("%d", &element);

    pos = n;

    for(i = 0; i < n; i++)
    {
        if(element < a[i])
        {
            pos = i;
            break;
        }
    }

    for(i = n; i > pos; i--)
    {
        a[i] = a[i - 1];
    }

    a[pos] = element;
    n++;

    for(i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }

    return 0;
}
